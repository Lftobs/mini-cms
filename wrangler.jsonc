{
  // Replace with real ids from: npx wrangler kv namespace create KV
  "name": "mini-cms",
  "pages_build_output_dir": "./dist",
  "compatibility_date": "2025-09-15",
  "compatibility_flags": ["nodejs_compat"],
  "kv_namespaces": [
    {
      "binding": "KV",
      "id": "<replace-with-kv-namespace-id>",
      "preview_id": "<replace-with-preview-namespace-id>"
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "COLLAB",
        "class_name": "CollabRoom"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_classes": ["CollabRoom"]
    }
  ],
  "vars": {
    "SITE": "https://mini-cms.xyz",
    "APP_ENV": "prod",
    "PUBLIC_APP_ENV": "prod",
    "BASE_URL": "https://mini-cms.xyz"
  }
}
